/*****************************************************/
/* keyword_lookup - a function to lookup keywords,
   noise words, and identifiers using a DFA state machine */
int keyword_lookup()
{
    int state = 0; /* State 0: Start state*/
    
    addChar();

    switch (tolower(nextChar)) {
        case 'a': 
            state = 1; 
            break;
        case 'o': /* [EXPR] 'o' */
            state = 6;
            break;
        case 'h': /* [EXPR] start of 'hindi' */
            state = 7;
            break;
        case 't': /* [EXPR] start of 'Totoo' or [STMT] 'tul' */
            state = 12; // Will be handled or differentiated in transition
            break;
        case 'p': /* [EXPR] start of 'Palso' */
            state = 17;
            break;
        case 'b': /* [STMT] start of 'b...' */
            state = 22;
            break;
        case 'k': /* [STMT] start of 'k...' */
            state = 29;
            break;
        case 'l': /* [STMT] start of 'l...' */
            state = 43;
            break;
        case 'n': /* [STMT] start of 'n...' or 'ng' */
            state = 48;
            break;
        case 's': /* [STMT] start of 's...' */
            state = 55;
            break;
        default:  
            state = 99; //sink state for identifiers
            break;
    }
    
    getChar();
    
    /* Consume characters and transition states */
    while (charClass == LETTER || charClass == DIGIT || nextChar == '_'){
        addChar();
        
        switch (state){
            case 1:
                if (tolower(nextChar) == 'y') state = 2; //'ay'
                else if (tolower(nextChar) == 'n') state = 3; // 'an'
                else if (tolower(nextChar) == 't') state = 5; // [EXPR] 'at'
                else state = 99;
                break;
            
            case 3: // 'an'
                if (tolower(nextChar) == 'g') state = 4; //'ang'
                else state = 99;
                break;
            
            /* [EXPR] states 7-11: h-i-n-d-i, state 11 = 'hindi' */
            case 7:
                if (tolower(nextChar) == 'i') state = 8;
                else state = 99;
                break;
            case 8:
                if (tolower(nextChar) == 'n') state = 9;
                else state = 99;
                break;
            case 9:
                if (tolower(nextChar) == 'd') state = 10;
                else state = 99;
                break;
            case 10:
                if (tolower(nextChar) == 'i') state = 11;
                else state = 99;
                break;

            /* [EXPR] states 12-16: T-o-t-o-o, state 16 = 'Totoo' */
            case 12:
                if (tolower(nextChar) == 'o') state = 13;
                else if (tolower(nextChar) == 'u') state = 64; // 'tul' fallback
                else state = 99;
                break;
            case 13:
                if (tolower(nextChar) == 't') state = 14;
                else state = 99;
                break;
            case 14:
                if (tolower(nextChar) == 'o') state = 15;
                else state = 99;
                break;
            case 15:
                if (tolower(nextChar) == 'o') state = 16;
                else state = 99;
                break;

            /* [EXPR] states 17-21: P-a-l-s-o, state 21 = 'Palso' */
            case 17:
                if (tolower(nextChar) == 'a') state = 18;
                else if (tolower(nextChar) == 'i') state = 52; // 'pisi' fallback
                else state = 99;
                break;
            case 18:
                if (tolower(nextChar) == 'l') state = 19;
                else state = 99;
                break;
            case 19:
                if (tolower(nextChar) == 's') state = 20;
                else state = 99;
                break;
            case 20:
                if (tolower(nextChar) == 'o') state = 21;
                else state = 99;
                break;

            /* [STMT] state 22 = 'b' */
            case 22:
                if (tolower(nextChar) == 'a') state = 23;
                else state = 99;
                break;

            /* [STMT] state 23 = 'ba' */
            case 23:
                if (tolower(nextChar) == 'k') state = 24;
                else if (tolower(nextChar) == 'w') state = 26;
                else state = 99;
                break;

            /* [STMT] state 24 = 'bak' */
            case 24:
                if (tolower(nextChar) == 'a') state = 25;
                else state = 99;
                break;

            /* [STMT] state 26 = 'baw' */
            case 26:
                if (tolower(nextChar) == 'a') state = 27;
                else state = 99;
                break;

            /* [STMT] state 27 = 'bawa' */
            case 27:
                if (tolower(nextChar) == 't') state = 28;
                else state = 99;
                break;

            /* [STMT] state 29 = 'k' */
            case 29:
                if (tolower(nextChar) == 'a') state = 30;
                else if (tolower(nextChar) == 'u') state = 32;
                else state = 99;
                break;

            /* [STMT] state 30 = 'ka' */
            case 30:
                if (tolower(nextChar) == 'r') state = 31;
                else state = 99;
                break;

            /* [STMT] state 32 = 'ku' */
            case 32:
                if (tolower(nextChar) == 'n') state = 33;
                else state = 99;
                break;

            /* [STMT] state 33 = 'kun' */
            case 33:
                if (tolower(nextChar) == 'd') state = 34;
                else if (tolower(nextChar) == 'g') state = 40;
                else if (tolower(nextChar) == 'i') state = 41;
                else state = 99;
                break;

            /* [STMT] state 34 = 'kund' */
            case 34:
                if (tolower(nextChar) == 'i') state = 35;
                else state = 99;
                break;

            /* [STMT] state 35 = 'kundi' */
            case 35:
                if (tolower(nextChar) == 'k') state = 36;
                else state = 99;
                break;

            /* [STMT] state 36 = 'kundik' */
            case 36:
                if (tolower(nextChar) == 'u') state = 37;
                else state = 99;
                break;

            /* [STMT] state 37 = 'kundiku' */
            case 37:
                if (tolower(nextChar) == 'n') state = 38;
                else state = 99;
                break;

            /* [STMT] state 38 = 'kundikun' */
            case 38:
                if (tolower(nextChar) == 'g') state = 39;
                else state = 99;
                break;

            /* [STMT] state 41 = 'kuni' */
            case 41:
                if (tolower(nextChar) == 'n') state = 42;
                else state = 99;
                break;

            /* [STMT] state 43 = 'l' */
            case 43:
                if (tolower(nextChar) == 'i') state = 44;
                else state = 99;
                break;

            /* [STMT] state 44 = 'li' */
            case 44:
                if (tolower(nextChar) == 's') state = 45;
                else state = 99;
                break;

            /* [STMT] state 45 = 'lis' */
            case 45:
                if (tolower(nextChar) == 't') state = 46;
                else state = 99;
                break;

            /* [STMT] state 46 = 'list' */
            case 46:
                if (tolower(nextChar) == 'a') state = 47;
                else state = 99;
                break;

            /* [STMT] state 48 = 'n' or 'N' */
            case 48:
                if (tolower(nextChar) == 'g') state = 66; /* Catches ng, NG, Ng, nG */
                else if (tolower(nextChar) == 'u') state = 49;
                else state = 99;
                break;
            case 66:
                state = 99;
                break;

            /* [STMT] state 49 = 'nu' */
            case 49:
                if (tolower(nextChar) == 'm') state = 50;
                else state = 99;
                break;

            /* [STMT] state 52 = 'pi' */
            case 52:
                if (tolower(nextChar) == 's') state = 53;
                else state = 99;
                break;

            /* [STMT] state 53 = 'pis' */
            case 53:
                if (tolower(nextChar) == 'i') state = 54;
                else state = 99;
                break;

            /* [STMT] state 55 = 's' */
            case 55:
                if (tolower(nextChar) == 'a') state = 56;
                else if (tolower(nextChar) == 'u') state = 57;
                else state = 99;
                break;

            /* [STMT] state 57 = 'su' */
            case 57:
                if (tolower(nextChar) == 'l') state = 58;
                else state = 99;
                break;

            /* [STMT] state 58 = 'sul' */
            case 58:
                if (tolower(nextChar) == 'a') state = 59;
                else state = 99;
                break;

            /* [STMT] state 59 = 'sula' */
            case 59:
                if (tolower(nextChar) == 't') state = 60;
                else state = 99;
                break;

            /* [STMT] state 60 = 'sulat' */
            case 60:
                if (tolower(nextChar) == 'l') state = 61;
                else state = 99;
                break;

            /* [STMT] state 61 = 'sulatl' */
            case 61:
                if (tolower(nextChar) == 'n') state = 62;
                else state = 99;
                break;

            /* [STMT] state 64 = 'tu' */
            case 64:
                if (tolower(nextChar) == 'l') state = 65;
                else state = 99;
                break;

            default: //sink state
                state = 99; 
                break;
        }
        
        getChar();
    }
    
    /* Return the correct token based on the final state reached */
    if (state == 5)
        return AT_OP;     /* at    */
    if (state == 6)
        return O_OP;      /* o     */
    if (state == 11)
        return HINDI_OP;  /* hindi */
    if (state == 16)
        return TRUE_LIT;  /* Totoo */
    if (state == 21)
        return FALSE_LIT; /* Palso */
    if (state == 25)
        return TYPE_BAKA; /* baka */
    if (state == 28)
        return KW_BAWAT; /* bawat */
    if (state == 31)
        return TYPE_KAR; /* kar */
    if (state == 35)
        return KW_KUNDI; /* kundi */
    if (state == 39)
        return KW_KUNDIKUNG; /* kundikung */
    if (state == 40)
        return KW_KUNG; /* kung */
    if (state == 42)
        return IO_KUNIN; /* kunin */
    if (state == 47)
        return TYPE_LISTA; /* lista */
    if (state == 50)
        return TYPE_NUM; /* num */
    if (state == 54)
        return TYPE_PISI; /* pisi */
    if (state == 56)
        return KW_SA; /* sa */
    if (state == 60)
        return IO_SULAT; /* sulat */
    if (state == 62)
        return IO_SULATLN; /* sulatln */
    if (state == 65)
        return TYPE_TUL; /* tul */
        
    if (state == 2 || state == 4 || state == 66) {
        return NOISE_WORD;
    } else {
        return IDENT;
    }
}
