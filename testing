            case 57:
                if (tolower(nextChar) == 'l') state = 58;
                else state = 99;
                break;
            case 58:
                if (tolower(nextChar) == 'a') state = 59;
                else state = 99;
                break;
            case 59:
                if (tolower(nextChar) == 't') state = 60;
                else state = 99;
                break;
            case 60:
                if (tolower(nextChar) == 'l') state = 61;
                else state = 99;
                break;
            case 61:
                if (tolower(nextChar) == 'n') state = 62;
                else state = 99;
                break;
            case 64:
                if (tolower(nextChar) == 'l') state = 65;
                else state = 99;
                break;
            default:
                state = 99; 
                break;
        }
        getChar();
    }
    
    if (state == 5) return AT_OP;
    if (state == 6) return O_OP;
    if (state == 11) return HINDI_OP;
    if (state == 16) return TRUE_LIT;
    if (state == 21) return FALSE_LIT;
    if (state == 25) return TYPE_BAKA;
    if (state == 28) return KW_BAWAT;
    if (state == 31) return TYPE_KAR;
    if (state == 35) return KW_KUNDI;
    if (state == 39) return KW_KUNDIKUNG;
    if (state == 40) return KW_KUNG;
    if (state == 42) return IO_KUNIN;
    if (state == 47) return TYPE_LISTA;
    if (state == 50) return TYPE_NUM;
    if (state == 54) return TYPE_PISI;
    if (state == 56) return KW_SA;
    if (state == 60) return IO_SULAT;
    if (state == 62) return IO_SULATLN;
    if (state == 65) return TYPE_TUL;
        
    if (state == 2 || state == 4 || state == 66) {
        return NOISE_WORD;
    } else {
        return IDENT;
    }
}
