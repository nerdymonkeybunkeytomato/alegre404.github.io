/* getChar - supports standard chars AND ñ / Ñ (UTF-8 0xC3) */
void getChar()
{
    if ((nextChar = getc(in_fp)) != EOF)
    {
        if (nextChar == '\n')
            lineNo++;

        /* Check for UTF-8 multi-byte characters like Ñ or ñ (Lead byte 0xC3) */
        if ((unsigned char)nextChar == 0xC3) {
            int next_byte = getc(in_fp);
            if (next_byte == 0x91 || next_byte == 0xB1) { /* 0x91 = Ñ, 0xB1 = ñ */
                charClass = LETTER;
                return;
            } else {
                ungetc(next_byte, in_fp);
            }
        }

        if (isalpha(nextChar))
            charClass = LETTER;
        else if (isdigit(nextChar))
            charClass = DIGIT;
        else
            charClass = UNKNOWN;
    }
    else
        charClass = EOF;
}
/*****************************************************/
void getNonBlank() {
    while (isspace(nextChar) || nextChar == '#'){
        if (isspace(nextChar)){
            getChar();
        }else if (nextChar == '#'){
            if (peekChar() == '#'){
                getChar();
                getChar();
                while (nextChar != EOF){
                    if (nextChar == '#' && peekChar() == '#'){
                        getChar(); getChar();
                        break;
                    }
                    getChar();
                }
            }else{
                while (nextChar != EOF && nextChar != '\n'){
                    getChar();
                }
            }
        }
    }
}

/*****************************************************/
int lex()
{
    lexLen = 0;
    lexeme[0] = '\0';

    if (pending_dedents > 0)
    {
        pending_dedents--;
        nextToken = TOKEN_DEDENT;
        snprintf(lexeme, sizeof lexeme, "DEDENT");
        printf("Next token is: %d, Next lexeme is %s\n", nextToken, lexeme);
        return nextToken;
    }

    for (;;)
    {
        if (is_at_line_start)
        {
            int space_count = 0;

            while (nextChar == ' ' || nextChar == '\t')
            {
                space_count += (nextChar == '\t') ? 4 : 1;
                getChar();
            }

            if (nextChar == '\n' || (nextChar == '\r' && peekChar() == '\n'))
            {
                getChar();
                if (nextChar == '\n')
                    getChar();
                continue;
            }

            if (nextChar == '#')
            {
                if (peekChar() == '#')
                {
                    getChar();
                    getChar();
                    while (charClass != EOF)
                    {
                        if (nextChar == '#' && peekChar() == '#')
                        {
                            getChar();
                            getChar();
                            break;
                        }
                        if (nextChar == '\n')
                        {
                            is_at_line_start = 1;
                            line_has_token = 0;
                        }
                        getChar();
                    }
                    if (is_at_line_start)
                        continue;
                }
                else
                {
                    while (charClass != EOF && nextChar != '\n')
                        getChar();
                    if (nextChar == '\n')
                        getChar();
                    continue;
                }
            }

            if (charClass == EOF)
            {
                if (indent_top > 0)
                {
                    pending_dedents = indent_top - 1;
                    indent_top = 0;
                    nextToken = TOKEN_DEDENT;
                    snprintf(lexeme, sizeof lexeme, "DEDENT");
                    printf("Next token is: %d, Next lexeme is %s\n", nextToken, lexeme);
                    return nextToken;
                }
                nextToken = EOF;
                strcpy(lexeme, "EOF");
                printf("Next token is: %d, Next lexeme is %s\n", nextToken, lexeme);
                return nextToken;
            }

            is_at_line_start = 0;
            if (space_count > indent_stack[indent_top])
            {
                if (indent_top >= MAX_INDENT_DEPTH - 1)
                {
                    printf("Error: Indentation too deep.\n");
                    nextToken = TOKEN_ERROR;
                    strcpy(lexeme, "ERROR");
                    printf("Next token is: %d, Next lexeme is %s\n", nextToken, lexeme);
                    return nextToken;
                }
                indent_stack[++indent_top] = space_count;
                nextToken = TOKEN_INDENT;
                strcpy(lexeme, "INDENT");
                printf("Next token is: %d, Next lexeme is %s\n", nextToken, lexeme);
                return nextToken;
            }
            if (space_count < indent_stack[indent_top])
            {
                while (indent_top > 0 && space_count < indent_stack[indent_top])
                {
                    indent_top--;
                    pending_dedents++;
                }
                if (space_count != indent_stack[indent_top])
                {
                    printf("Error: Unindent does not match any outer indentation level.\n");
                    nextToken = TOKEN_ERROR;
                    strcpy(lexeme, "ERROR");
                    printf("Next token is: %d, Next lexeme is %s\n", nextToken, lexeme);
                    return nextToken;
                }
                pending_dedents--;
                nextToken = TOKEN_DEDENT;
                strcpy(lexeme, "DEDENT");
                printf("Next token is: %d, Next lexeme is %s\n", nextToken, lexeme);
                return nextToken;
            }
        }

        if (nextChar == '#')
        {
            if (peekChar() == '#')
            {
                getChar();
                getChar();
                while (charClass != EOF)
                {
                    if (nextChar == '#' && peekChar() == '#')
                    {
                        getChar();
                        getChar();
                        break;
                    }
                    if (nextChar == '\n' && bracketTop == 0)
                    {
                        is_at_line_start = 1;
                        line_has_token = 0;
                    }
                    getChar();
                }
                continue;
            }
            while (charClass != EOF && nextChar != '\n')
                getChar();
            continue;
        }

        if (isspace((unsigned char)nextChar))
        {
            if (nextChar == '\n')
            {
                getChar();
                if (bracketTop > 0)
                    continue;
                is_at_line_start = 1;
                if (line_has_token)
                {
                    line_has_token = 0;
                    nextToken = TOKEN_NEWLINE;
                    strcpy(lexeme, "NEWLINE");
                    printf("Next token is: %d, Next lexeme is %s\n", nextToken, lexeme);
                    return nextToken;
                }
                continue;
            }
            getChar();
            continue;
        }
        break;
    }

    switch (charClass)
    {
    case LETTER:
        nextToken = keyword_lookup();
        break;
    case DIGIT:
        addChar();
        getChar();
        while (charClass == DIGIT)
        {
            addChar();
            getChar();
        }
        if (nextChar == '.' && isdigit(peekChar()))
        {
            addChar();
            getChar();
            while (charClass == DIGIT)
            {
                addChar();
                getChar();
            }
            nextToken = FLOAT_LIT;
        }
        else
            nextToken = INT_LIT;
        break;
    case UNKNOWN:
        lookup(nextChar);
        getChar();
        break;
    case EOF:
        if (line_has_token)
        {
            line_has_token = 0;
            nextToken = TOKEN_NEWLINE;
            strcpy(lexeme, "NEWLINE");
            printf("Next token is: %d, Next lexeme is %s\n", nextToken, lexeme);
            return nextToken;
        }
        if (indent_top > 0)
        {
            pending_dedents = indent_top - 1;
            indent_top = 0;
            nextToken = TOKEN_DEDENT;
            strcpy(lexeme, "DEDENT");
            printf("Next token is: %d, Next lexeme is %s\n", nextToken, lexeme);
            return nextToken;
        }
        nextToken = EOF;
        strcpy(lexeme, "EOF");
        break;
    }
    if (nextToken != EOF)
        line_has_token = 1;
    printf("Next token is: %d, Next lexeme is %s\n",
           nextToken, lexeme);
    return nextToken;
}

/*****************************************************/
/* keyword_lookup - handles keywords, noise words, identifiers, and ng variations */
int keyword_lookup()
{
    int state = 0;
    
    addChar();

    switch (tolower(nextChar)) {
        case 'a': state = 1; break;
        case 'o': state = 6; break;
        case 'h': state = 7; break;
        case 't': state = 12; break;
        case 'p': state = 17; break;
        case 'b': state = 22; break;
        case 'k': state = 29; break;
        case 'l': state = 43; break;
        case 'n': state = 48; break;
        case 's': state = 55; break;
        default:  state = 99; break;
    }
    getChar();
    
    while (charClass == LETTER || charClass == DIGIT || nextChar == '_'){
        addChar();
        
        switch (state){
            case 1:
                if (tolower(nextChar) == 'y') state = 2;
                else if (tolower(nextChar) == 'n') state = 3;
                else if (tolower(nextChar) == 't') state = 5;
                else state = 99;
                break;
            case 3:
                if (tolower(nextChar) == 'g') state = 4;
                else state = 99;
                break;
            case 7:
                if (tolower(nextChar) == 'i') state = 8;
                else state = 99;
                break;
            case 8:
                if (tolower(nextChar) == 'n') state = 9;
                else state = 99;
                break;
            case 9:
                if (tolower(nextChar) == 'd') state = 10;
                else state = 99;
                break;
            case 10:
                if (tolower(nextChar) == 'i') state = 11;
                else state = 99;
                break;
            case 12:
                if (tolower(nextChar) == 'o') state = 13;
                else if (tolower(nextChar) == 'u') state = 64;
                else state = 99;
                break;
            case 13:
                if (tolower(nextChar) == 't') state = 14;
                else state = 99;
                break;
            case 14:
                if (tolower(nextChar) == 'o') state = 15;
                else state = 99;
                break;
            case 15:
                if (tolower(nextChar) == 'o') state = 16;
                else state = 99;
                break;
            case 17:
                if (tolower(nextChar) == 'a') state = 18;
                else if (tolower(nextChar) == 'i') state = 52;
                else state = 99;
                break;
            case 18:
                if (tolower(nextChar) == 'l') state = 19;
                else state = 99;
                break;
            case 19:
                if (tolower(nextChar) == 's') state = 20;
                else state = 99;
                break;
            case 20:
                if (tolower(nextChar) == 'o') state = 21;
                else state = 99;
                break;
            case 22:
                if (tolower(nextChar) == 'a') state = 23;
                else state = 99;
                break;
            case 23:
                if (tolower(nextChar) == 'k') state = 24;
                else if (tolower(nextChar) == 'w') state = 26;
                else state = 99;
                break;
            case 24:
                if (tolower(nextChar) == 'a') state = 25;
                else state = 99;
                break;
            case 26:
                if (tolower(nextChar) == 'a') state = 27;
                else state = 99;
                break;
            case 27:
                if (tolower(nextChar) == 't') state = 28;
                else state = 99;
                break;
            case 29:
                if (tolower(nextChar) == 'a') state = 30;
                else if (tolower(nextChar) == 'u') state = 32;
                else state = 99;
                break;
            case 30:
                if (tolower(nextChar) == 'r') state = 31;
                else state = 99;
                break;
            case 32:
                if (tolower(nextChar) == 'n') state = 33;
                else state = 99;
                break;
            case 33:
                if (tolower(nextChar) == 'd') state = 34;
                else if (tolower(nextChar) == 'g') state = 40;
                else if (tolower(nextChar) == 'i') state = 41;
                else state = 99;
                break;
            case 34:
                if (tolower(nextChar) == 'i') state = 35;
                else state = 99;
                break;
            case 35:
                if (tolower(nextChar) == 'k') state = 36;
                else state = 99;
                break;
            case 36:
